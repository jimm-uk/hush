# Sourced via BASH_ENV for every non-interactive bash the sandbox starts.
export VIRTUAL_ENV=/opt/office-py
export PATH=/opt/office-py/bin:$PATH
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export PI_OFFLINE=1 PI_SKIP_VERSION_CHECK=1 PI_TELEMETRY=0
# No host credentials in this sandbox (sbx injects GH_TOKEN by default).
unset GH_TOKEN GITHUB_TOKEN SSH_AUTH_SOCK
