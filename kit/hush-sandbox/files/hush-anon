#!/opt/office-py/bin/python
"""hush-anon — deterministic anonymisation of Office files (.docx .xlsx .pptx).

The model never edits the document. It only helps build a mapping
(placeholder -> every variant of a name). Replacement and checking are
deterministic.

  hush-anon extract DOC            all text (incl. headers, notes, comments,
                                   tracked deletions, metadata) -> DOC.text.md
                                   + spaCy/regex hints -> DOC.candidates.json
  hush-anon propose DOC            ask two local models (independently) for the
                                   identifying entities; merge, verify against
                                   the text, write draft DOC.map.json
  (a human reviews / edits DOC.map.json)
  hush-anon apply DOC MAP [-o OUT] replace every variant everywhere, longest
                                   first, across split runs; scrub metadata
  hush-anon check OUT MAP          search every part + filename for any
                                   variant; exit 1 on any leak

Legacy .doc/.xls/.ppt: convert first, e.g.
  soffice --headless --convert-to docx file.doc
"""
import argparse
import collections
import json
import os
import re
import sys
import urllib.request
import zipfile
from pathlib import Path

from lxml import etree

W = "http://schemas.openxmlformats.org/wordprocessingml/2006/main"
A = "http://schemas.openxmlformats.org/drawingml/2006/main"
S = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
XML_SPACE = "{http://www.w3.org/XML/1998/namespace}space"
TEXT_TAGS = {f"{{{W}}}t", f"{{{W}}}delText", f"{{{W}}}instrText", f"{{{A}}}t", f"{{{S}}}t"}
PARA_TAGS = {f"{{{W}}}p", f"{{{A}}}p", f"{{{S}}}si", f"{{{S}}}is"}
TRAILING_MARKS = "™®©℠"

MLX_URL = os.environ.get("HUSH_MLX_URL", "http://host.docker.internal:8080/v1/chat/completions")
def _models_root():
    # The host's model folder: the MLX server loads models by host path.
    # hush writes it to ~/.pi/agent/models-root each session.
    if os.environ.get("HUSH_MODELS_ROOT"):
        return os.environ["HUSH_MODELS_ROOT"]
    try:
        with open(os.path.expanduser("~/.pi/agent/models-root")) as f:
            return f.read().strip()
    except OSError:
        return "~/models"


MODELS_ROOT = _models_root()
DEFAULT_MODELS = os.environ.get(
    "HUSH_ANON_MODELS",
    # Fast second opinion first, then Qwen3.6 (best in testing, and Pi's default,
    # so it's loaded again for Pi afterwards: no extra reload).
    f"{MODELS_ROOT}/lmstudio-community/Qwen3-Coder-30B-A3B-Instruct-MLX-6bit,"
    f"{MODELS_ROOT}/lmstudio-community/Qwen3.6-35B-A3B-MLX-8bit:think",
)

DEFAULT_POLICY = """Anonymise IDENTIFYING information only:
- names of people (full names, first names, surnames, initials, usernames)
- the organisations / companies the document is about or written by/for,
  including legal names, short names, abbreviations and ALL-CAPS forms
- their own products, services, projects, brands and codenames
- contact details: emails, phone numbers, street addresses, postcodes, URLs/domains
- identifiers: account / registration / case / invoice / employee numbers
KEEP (do not list): generic subjects and topics, industries, technologies in
general, well-known public third-party tools/standards/organisations that are
merely mentioned (e.g. Excel, ISO 27001, the EU), countries, dates, amounts."""


# ----------------------------------------------------------------- reading --

def xml_parts(zf):
    for info in zf.infolist():
        if info.filename.endswith((".xml", ".rels")):
            yield info.filename


def parse(data):
    return etree.fromstring(data, etree.XMLParser(resolve_entities=False, huge_tree=True, remove_blank_text=False))


def para_of(node):
    p = node.getparent()
    while p is not None and p.tag not in PARA_TAGS:
        p = p.getparent()
    return p


def paragraphs(root):
    """[(para_element, [text nodes in order])] — groups text split across runs."""
    groups = collections.OrderedDict()
    for el in root.iter():
        if el.tag in TEXT_TAGS:
            groups.setdefault(para_of(el), []).append(el)
    return list(groups.items())


def doc_text(path):
    """{part: [paragraph strings]} for every XML part with visible text."""
    out = collections.OrderedDict()
    with zipfile.ZipFile(path) as zf:
        for name in xml_parts(zf):
            root = parse(zf.read(name))
            paras = []
            for _, nodes in paragraphs(root):
                t = "".join(n.text or "" for n in nodes)
                if any(n.tag == f"{{{W}}}delText" for n in nodes):
                    t = "[tracked deletion] " + t
                if t.strip():
                    paras.append(t)
            # metadata and other plain-text elements (docProps, custom XML)
            if not paras and not name.endswith(".rels"):
                for el in root.iter():
                    if isinstance(el.tag, str) and el.text and el.text.strip() and len(el) == 0:
                        paras.append(f"{etree.QName(el).localname}: {el.text.strip()}")
            if paras:
                out[name] = paras
    return out


# ---------------------------------------------------------------- matching --

def load_map(path):
    m = json.loads(Path(path).read_text())
    ents = m["entities"] if isinstance(m, dict) and "entities" in m else m
    pairs = []
    for e in ents:
        if e.get("keep"):
            continue
        for v in e["variants"]:
            v = v.strip()
            if v:
                pairs.append((v, e["placeholder"]))
    if not pairs:
        sys.exit("map has no variants to replace")
    return pairs


class Matcher:
    """Longest-first, case-insensitive, word-boundary-aware; also eats a
    trailing ™/®/© after a match (it would hint at the original)."""

    def __init__(self, pairs):
        seen = {}
        for v, ph in pairs:
            seen.setdefault(v.lower(), (v, ph))
        self.pairs = sorted(seen.values(), key=lambda p: -len(p[0]))
        alts = []
        for v, _ in self.pairs:
            e = re.escape(v)
            if v[0].isalnum():
                e = r"(?<![\w])" + e
            if v[-1].isalnum():
                e = e + r"(?![\w])"
            alts.append(f"(?:{e})")
        self.rx = re.compile("(" + "|".join(alts) + f")[{TRAILING_MARKS}]?", re.IGNORECASE)
        self.lookup = {v.lower(): ph for v, ph in self.pairs}

    def ph(self, m):
        return self.lookup[m.group(1).lower()]

    def sub(self, s):
        return self.rx.sub(lambda m: self.ph(m), s)

    def finditer(self, s):
        return self.rx.finditer(s)


def rewrite_nodes(nodes, matcher, counts):
    texts = [n.text or "" for n in nodes]
    joined = "".join(texts)
    if not matcher.rx.search(joined):
        return
    owner = [i for i, t in enumerate(texts) for _ in t]
    bufs = [[] for _ in texts]
    pos = 0
    for m in matcher.finditer(joined):
        for p in range(pos, m.start()):
            bufs[owner[p]].append(joined[p])
        ph = matcher.ph(m)
        bufs[owner[m.start()]].append(ph)
        counts[ph] += 1
        pos = m.end()
    for p in range(pos, len(joined)):
        bufs[owner[p]].append(joined[p])
    for n, b in zip(nodes, bufs):
        n.text = "".join(b)
        if n.tag.startswith(f"{{{W}}}"):
            n.set(XML_SPACE, "preserve")


META_CLEAR = {"creator", "lastModifiedBy", "Company", "Manager", "HyperlinkBase"}


def anonymise_part(name, data, matcher, counts, scrub_meta=True):
    root = parse(data)
    done = set()
    for _, nodes in paragraphs(root):
        rewrite_nodes(nodes, matcher, counts)
        done.update(nodes)
    for el in root.iter():
        if not isinstance(el.tag, str):
            continue
        if scrub_meta and name.startswith("docProps/") and etree.QName(el).localname in META_CLEAR and el.text:
            el.text = "Anonymous" if etree.QName(el).localname in ("creator", "lastModifiedBy") else ""
        if el not in done and el.text:
            new = matcher.sub(el.text)
            if new != el.text:
                counts["(other text)"] += 1
                el.text = new
        if el.tail:
            el.tail = matcher.sub(el.tail)
        for k, v in el.attrib.items():
            new = matcher.sub(v)
            if new != v:
                counts["(attributes)"] += 1
                el.set(k, new)
    return etree.tostring(root, xml_declaration=True, encoding="UTF-8", standalone=True)


# ---------------------------------------------------------------- commands --

def cmd_extract(a):
    doc = Path(a.doc)
    parts = doc_text(doc)
    md = [f"# Text of {doc.name}\n"]
    for part, paras in parts.items():
        md.append(f"\n## {part}\n")
        md.extend(paras)
    out = doc.with_name(doc.name + ".text.md")
    out.write_text("\n".join(md) + "\n")
    text = "\n".join(p for ps in parts.values() for p in ps)

    cands = collections.Counter()
    kinds = {}
    try:
        import spacy

        nlp = spacy.load("en_core_web_lg", disable=["lemmatizer"])
        nlp.max_length = max(nlp.max_length, len(text) + 1)
        for ent in nlp(text).ents:
            if ent.label_ in ("PERSON", "ORG", "PRODUCT", "GPE", "LOC", "FAC", "EVENT", "WORK_OF_ART", "NORP"):
                t = ent.text.strip(" .,;:()\"'")
                if len(t) > 1:
                    cands[t] += 1
                    kinds.setdefault(t, ent.label_)
    except Exception as e:  # spaCy is only a hint source
        print(f"note: spaCy hints skipped ({e})", file=sys.stderr)
    for rx, label in (
        (r"[\w.+-]+@[\w-]+\.[\w.-]+", "EMAIL"),
        (r"(?:https?://|www\.)[^\s)>\]]+", "URL"),
        (r"\+?\d[\d ()-]{8,}\d", "PHONE"),
        (r"\b[A-Z][\w-]*(?:\s+[A-Z][\w-]*)*\s*[™®]", "MARK"),
    ):
        for m in re.finditer(rx, text):
            cands[m.group().strip()] += 1
            kinds.setdefault(m.group().strip(), label)
    hints = [{"text": t, "kind": kinds[t], "count": n} for t, n in cands.most_common()]
    cj = doc.with_name(doc.name + ".candidates.json")
    cj.write_text(json.dumps(hints, indent=2, ensure_ascii=False))
    print(f"text:  {out}  ({sum(len(p) for p in parts.values())} paragraphs in {len(parts)} parts)")
    print(f"hints: {cj}  ({len(hints)} spaCy/regex candidates — hints only, not a mapping)")


PROMPT = """{policy}

Return ONLY a JSON array, no prose. One object per distinct real-world entity:
{{"type": "PERSON|COMPANY|PRODUCT|PROJECT|PLACE|EMAIL|PHONE|URL|ID|OTHER",
  "name": "<canonical name>",
  "variants": ["<every form exactly as it appears in the text: full, short,
               abbreviated, ALL CAPS, possessive-free>"]}}
Group all forms of the same entity into ONE object. Copy variants character
for character from the text. If nothing qualifies, return [].

TEXT:
<<<
{text}
>>>"""


def ask_model(model, text, policy, think):
    body = {
        "model": model,
        "messages": [{"role": "user", "content": PROMPT.format(policy=policy, text=text)}],
        "max_tokens": 6000,
        "temperature": 0,
        "chat_template_kwargs": {"enable_thinking": bool(think)},
    }
    req = urllib.request.Request(MLX_URL, json.dumps(body).encode(), {"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=1800) as r:
        msg = json.load(r)["choices"][0]["message"]
    content = re.sub(r"<think>.*?</think>", "", msg.get("content") or "", flags=re.S)
    m = re.search(r"\[.*\]", content, re.S)
    if not m:
        raise ValueError(f"no JSON array in reply: {content[:200]!r}")
    return json.loads(m.group())


def chunks(text, size=20000):
    buf, n = [], 0
    for line in text.splitlines(keepends=True):
        if n + len(line) > size and buf:
            yield "".join(buf)
            buf, n = [], 0
        buf.append(line)
        n += len(line)
    if buf:
        yield "".join(buf)


def cmd_propose(a):
    doc = Path(a.doc)
    parts = doc_text(doc)
    text = "\n".join(p for ps in parts.values() for p in ps)
    low = text.lower()
    policy = Path(a.policy).read_text() if a.policy else DEFAULT_POLICY
    found = []  # (model_label, entity)
    for spec in a.models.split(","):
        model, _, flag = spec.strip().partition(":")
        label = Path(model).name or model
        print(f"asking {label}{' (thinking)' if flag == 'think' else ''} …", file=sys.stderr, flush=True)
        try:
            for chunk in chunks(text):
                for e in ask_model(model, chunk, policy, flag == "think"):
                    if isinstance(e, dict) and e.get("variants"):
                        found.append((label, e))
        except Exception as ex:
            print(f"  {label} failed: {ex}", file=sys.stderr)

    # merge: entities sharing any variant (case-insensitive) are one entity
    merged = []
    for label, e in found:
        vs = {v.strip() for v in e.get("variants", []) + [e.get("name", "")] if isinstance(v, str) and v.strip()}
        vs = {v for v in vs if v.lower() in low}  # drop anything not actually in the text
        if not vs:
            continue
        keys = {v.lower() for v in vs}
        hit = next((m for m in merged if m["keys"] & keys), None)
        if hit:
            hit["variants"] |= vs
            hit["keys"] |= keys
            hit["found_by"].add(label)
            hit["types"].append(str(e.get("type", "OTHER")).upper())
        else:
            merged.append({"variants": vs, "keys": keys, "found_by": {label},
                           "types": [str(e.get("type", "OTHER")).upper()], "name": e.get("name")})

    n_models = len({lbl for lbl, _ in found}) or 1
    counter = collections.Counter()
    ents = []
    for m in sorted(merged, key=lambda m: (collections.Counter(m["types"]).most_common(1)[0][0], -len(max(m["variants"], key=len)))):
        typ = collections.Counter(m["types"]).most_common(1)[0][0]
        counter[typ] += 1
        auto = expand_variants(m["variants"], text) if typ in ("COMPANY", "PRODUCT", "PROJECT", "PERSON", "OTHER") else set()
        variants = sorted(m["variants"] | auto, key=lambda v: (-len(v), v))
        ent = {
            "placeholder": f"{typ}-{counter[typ]}",
            "name": m["name"] or variants[0],
            "variants": variants,
            "occurrences": count_hits(variants, text),
            "found_by": sorted(m["found_by"]),
            "review": len(m["found_by"]) < n_models,
        }
        if auto:
            ent["auto_added_variants"] = sorted(auto)
        ents.append(ent)
    covered = Matcher([(v, "X") for e in ents for v in e["variants"]]) if ents else None
    hints_path = doc.with_name(doc.name + ".candidates.json")
    unflagged = []
    if hints_path.exists():
        for h in json.loads(hints_path.read_text()):
            if h["kind"] in ("PERSON", "ORG", "PRODUCT", "EMAIL", "URL", "PHONE", "MARK") and not (covered and covered.rx.search(h["text"])):
                unflagged.append(h)
    out = Path(a.out) if a.out else doc.with_name(doc.name + ".map.json")
    out.write_text(json.dumps({
        "_how_to_review": "Edit freely: merge entities, add missing variants, rename placeholders. "
                          "Set \"keep\": true on an entity to leave it un-redacted. "
                          "\"review\": true = only one model flagged it — decide.",
        "entities": ents,
        "not_flagged_hints": unflagged,
    }, indent=2, ensure_ascii=False))
    print(f"draft map: {out}")
    for e in ents:
        flag = "  REVIEW (one model only)" if e["review"] else ""
        extra = f"  +auto {e['auto_added_variants']}" if e.get("auto_added_variants") else ""
        print(f"  {e['placeholder']:12} {e['occurrences']:3}x  {e['variants']}{extra}{flag}")
    if unflagged:
        print("spaCy/regex hints NOT covered by the map (check these by eye):")
        for h in unflagged[:25]:
            print(f"  {h['kind']:8} {h['count']:3}x  {h['text']}")



LEGAL_SUFFIX = re.compile(r"[,\s]+(ltd\.?|limited|inc\.?|incorporated|llc|plc|gmbh|corp\.?|corporation|co\.?|s\.a\.?|pty|ag|b\.v\.?)$", re.I)


def _common_word(w, _cache={}):
    """True if w is ordinary English (so unsafe to redact on its own)."""
    if "nlp" not in _cache:
        try:
            import spacy
            _cache["nlp"] = spacy.load("en_core_web_lg", disable=["parser", "ner", "tagger", "lemmatizer"])
        except Exception:
            _cache["nlp"] = None
    nlp = _cache["nlp"]
    if nlp is None:
        return True
    lex = nlp.vocab[w.lower()]
    return lex.has_vector and lex.rank < 200000 or lex.is_stop


def expand_variants(variants, text):
    """Add shorter forms that occur on their own: name without legal suffix,
    and an unusual leading word (e.g. 'Zorvex' from 'Zorvex Technologies Ltd.')."""
    added = set()
    low = text.lower()
    for v in list(variants):
        base = LEGAL_SUFFIX.sub("", v).strip()
        cands = {base}
        words = base.split()
        if len(words) > 1 and words[0][:1].isupper() and len(words[0]) > 2 and not _common_word(words[0]):
            cands.add(words[0])
        for c in cands:
            if c and c.lower() not in {x.lower() for x in variants} and re.search(r"(?<![\w])" + re.escape(c.lower()) + r"(?![\w])", low):
                added.add(c)
    return added


def count_hits(variants, text):
    return sum(1 for _ in Matcher([(v, "X") for v in variants]).finditer(text))


def default_out(doc, matcher):
    # Drop names from the file name entirely (a placeholder there reads oddly).
    stem = matcher.rx.sub("", doc.stem)
    stem = re.sub(r"\s+", " ", stem).strip(" _-.") or "document"
    return doc.with_name(f"{stem}_ANON{doc.suffix}")


def cmd_apply(a):
    doc = Path(a.doc)
    matcher = Matcher(load_map(a.map))
    out = Path(a.out) if a.out else default_out(doc, matcher)
    if out.resolve() == doc.resolve():
        sys.exit("refusing to overwrite the original")
    counts = collections.Counter()
    with zipfile.ZipFile(doc) as src, zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as dst:
        for info in src.infolist():
            data = src.read(info.filename)
            if info.filename.endswith((".xml", ".rels")):
                data = anonymise_part(info.filename, data, matcher, counts, scrub_meta=not a.keep_meta)
            dst.writestr(info, data)
    print(f"wrote {out}")
    for k, v in sorted(counts.items()):
        print(f"  {k:14} {v}")
    print(f"next: hush-anon check '{out}' '{a.map}'")


def cmd_check(a):
    out = Path(a.doc)
    pairs = load_map(a.map)
    variants = sorted({v for v, _ in pairs}, key=len, reverse=True)
    leaks = []
    for v in variants:
        if Matcher([(v, "X")]).rx.search(out.name):
            leaks.append(("(file name)", v, out.name))
    with zipfile.ZipFile(out) as zf:
        bad = zf.testzip()
        if bad:
            leaks.append(("(zip)", "corrupt member", bad))
        media = [n for n in zf.namelist() if re.match(r"(word|ppt|xl)/(media|embeddings)/", n)]
        for name in xml_parts(zf):
            raw = zf.read(name).decode("utf8", "ignore")
            root = parse(zf.read(name))
            joined = ["".join(n.text or "" for n in nodes) for _, nodes in paragraphs(root)]
            flat = " ".join(" ".join(t.split()) for t in joined)
            for v in variants:
                rx = Matcher([(v, "X")]).rx  # same whole-word, case-insensitive rule as apply
                for src, how in ((flat, "text"), (raw, "xml")):
                    m = rx.search(src)
                    if m:
                        i = m.start()
                        leaks.append((name, v, f"{how}: …{src[max(0, i - 40):i + len(v) + 40]}…"))
                        break
        text = "\n".join(p for ps in doc_text(out).values() for p in ps)
    warns = []
    for rx, what in ((r"[\w.+-]+@[\w-]+\.[\w.-]+", "email"), (r"(?:https?://|www\.)[^\s)>\]]+", "URL"),
                     (r"\+?\d[\d ()-]{8,}\d", "phone-like number")):
        hits = sorted(h for h in set(re.findall(rx, text)) if not re.fullmatch(r"\d{4}-\d{2}-\d{2}(T.*)?", h.strip()))
        if hits:
            warns.append(f"{what}s still present: {hits[:8]}")
    if media:
        warns.append(f"{len(media)} embedded media/objects NOT checked (images may show names): {media[:5]}")
    print(f"checked {out.name} against {len(variants)} variants")
    for w in warns:
        print(f"  warning: {w}")
    if leaks:
        print(f"LEAKS: {len(leaks)}")
        for part, v, ctx in leaks:
            print(f"  {v!r} in {part}: {ctx}")
        sys.exit(1)
    print("PASS: no variant found in any part or in the file name")


def main():
    ap = argparse.ArgumentParser(prog="hush-anon", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)
    p = sp.add_parser("extract"); p.add_argument("doc"); p.set_defaults(f=cmd_extract)
    p = sp.add_parser("propose"); p.add_argument("doc"); p.add_argument("--models", default=DEFAULT_MODELS,
        help="comma list of model ids/paths; suffix :think to enable thinking")
    p.add_argument("--policy", help="file with what to anonymise / keep"); p.add_argument("-o", "--out")
    p.set_defaults(f=cmd_propose)
    p = sp.add_parser("apply"); p.add_argument("doc"); p.add_argument("map"); p.add_argument("-o", "--out")
    p.add_argument("--keep-meta", action="store_true", help="don't blank author/company metadata")
    p.set_defaults(f=cmd_apply)
    p = sp.add_parser("check"); p.add_argument("doc"); p.add_argument("map"); p.set_defaults(f=cmd_check)
    a = ap.parse_args()
    a.f(a)


if __name__ == "__main__":
    main()
